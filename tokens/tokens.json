{
  "$meta": {
    "name": "letsimpl.fyi brand tokens",
    "version": "0.2.0",
    "source": "Derived from letsimpl.fyi DESIGN.md v0.1 and chaikadi.fyi DESIGN.md v0.3, extended in v0.2 with status crayons, ink variants, a reading font and display modes. Edit this file, then run `npm run tokens`."
  },
  "color": {
    "page": { "light": "#FFFFFF", "dark": "#000000", "use": "Page background" },
    "ink": { "light": "#000000", "dark": "#FFFFFF", "use": "Text, borders, focus ring" },
    "muted": { "light": "#4D4D4D", "dark": "#B8B8B8", "use": "Secondary text" },
    "line": { "light": "#767676", "dark": "#767676", "use": "Hairlines, disabled edges (4.5:1 on both pages)" },
    "tape": { "light": "#D2D2D2", "dark": "#5A5A5A", "use": "Masking tape on prints only" },
    "receipt": { "light": "#FBF6E9", "dark": "#EDE7D6", "use": "Receipt paper stock (never inverts)" },
    "crayon-ink": { "light": "#111111", "dark": "#111111", "use": "Text on any crayon fill" },
    "yellow": { "value": "#FFE066", "use": "Crayon. The slip in the wordmark; the room code in apps. Brand only, never a status" },
    "blue": { "value": "#9FCBFF", "use": "Crayon. Outbound: links and actions that leave the page" },
    "green": { "value": "#A7E3A0", "use": "Crayon. The one forward action; success; online and role tags" },
    "coral": { "value": "#F76C5A", "use": "Crayon. Destructive actions and errors" },
    "amber": { "value": "#FFB35C", "use": "Crayon. Warning and attention" },
    "teal": { "value": "#7ED6C9", "use": "Crayon. Information and neutral highlight" },
    "danger-ink": { "light": "#B3261E", "dark": "#FF8F7A", "use": "Text, icons and borders for errors on the bare page" },
    "success-ink": { "light": "#1B6E3C", "dark": "#7FDB9A", "use": "Text and icons for success on the bare page" },
    "warning-ink": { "light": "#8A5A00", "dark": "#FFC24D", "use": "Text and icons for warnings on the bare page" },
    "info-ink": { "light": "#0B5CAD", "dark": "#8CC4FF", "use": "Text and icons for information on the bare page" }
  },
  "font": {
    "family": {
      "ui": "\"Atkinson Hyperlegible Mono\", ui-monospace, \"Courier New\", monospace",
      "read": "\"Atkinson Hyperlegible Next\", system-ui, sans-serif",
      "receipt": "\"Courier Prime\", \"Courier New\", monospace",
      "malayalam": "\"Noto Serif Malayalam\", serif"
    },
    "weight": { "regular": "400", "medium": "500", "bold": "700" },
    "root-size": "112.5%"
  },
  "type": {
    "hero": { "size": "1.5rem", "line": "1.4167", "px": "27 / 38" },
    "title": { "size": "1.75rem", "line": "1.25", "px": "32 / 40" },
    "section": { "size": "1.25rem", "line": "1.35", "px": "22 / 30" },
    "sub": { "size": "1rem", "line": "1.5556", "px": "18 / 28" },
    "body": { "size": "1rem", "line": "1.5556", "px": "18 / 28" },
    "secondary": { "size": "0.8889rem", "line": "1.5", "px": "16 / 24" },
    "small": { "size": "0.7778rem", "line": "1.4286", "px": "14 / 20" },
    "total": { "size": "1.75rem", "line": "1.125", "px": "32 / 36" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "layout": {
    "measure": "560px",
    "pad-phone": "16px",
    "pad-wide": "24px",
    "touch-min": "44px",
    "touch-preferred": "48px"
  },
  "border": { "rule": "2px solid var(--ink)", "hair": "1px solid var(--line)", "focus": "3px" },
  "radius": { "square": "0", "crayon": "2px 3px 2px 4px" },
  "motion": {
    "state": "120ms",
    "sheet": "200ms",
    "wordmark": "4.4s"
  },
  "texture": {
    "crayon-hatch": "repeating-linear-gradient(115deg, rgb(255 255 255 / 22%) 0 1.5px, transparent 1.5px 4px, rgb(0 0 0 / 5%) 4px 5px, transparent 5px 7px)",
    "tape-hatch": "repeating-linear-gradient(115deg, rgb(255 255 255 / 25%) 0 1.5px, transparent 1.5px 4px)"
  },
  "display": {
    "$comment": "User display settings, applied as data attributes on <html>: data-text=\"large\", data-contrast=\"high\", data-colour=\"reduced\".",
    "text-large-root-size": "125%",
    "reduced-crayon": "#E6E6E6"
  }
}
