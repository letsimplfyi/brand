{
  "$meta": {
    "name": "letsimpl.fyi brand tokens",
    "version": "0.3.0",
    "source": "Derived from letsimpl.fyi DESIGN.md v0.1 and chaikadi.fyi DESIGN.md v0.3. v0.3 removes all brand colour: black and white only, with four functional status colours taken from Paul Tol's colour schemes. Edit this file, then run `npm run tokens`."
  },
  "color": {
    "page": {
      "light": "#FFFFFF",
      "dark": "#000000",
      "use": "Page background"
    },
    "ink": {
      "light": "#000000",
      "dark": "#FFFFFF",
      "use": "Text, borders, focus ring"
    },
    "muted": {
      "light": "#4D4D4D",
      "dark": "#B8B8B8",
      "use": "Secondary text"
    },
    "line": {
      "light": "#767676",
      "dark": "#767676",
      "use": "Hairlines, disabled edges (4.5:1 on both pages)"
    },
    "tape": {
      "light": "#D2D2D2",
      "dark": "#5A5A5A",
      "use": "Masking tape on prints only"
    },
    "receipt": {
      "light": "#FBF6E9",
      "dark": "#EDE7D6",
      "use": "Receipt paper stock (never inverts)"
    },
    "crayon-ink": {
      "light": "#111111",
      "dark": "#111111",
      "use": "Text on any status fill"
    },
    "danger": {
      "value": "#EE8866",
      "use": "Fill. Destructive actions and errors. Tol light 'orange'"
    },
    "warning": {
      "value": "#EEDD88",
      "use": "Fill. Warning and attention. Tol light 'light yellow'"
    },
    "success": {
      "value": "#44BB99",
      "use": "Fill. Success and confirmed. Tol light 'mint'"
    },
    "info": {
      "value": "#99DDFF",
      "use": "Fill. Information. Tol light 'light cyan'"
    },
    "danger-ink": {
      "light": "#CC3311",
      "dark": "#EE8866",
      "use": "Text, icons and borders for errors on the bare page. Light: Tol vibrant 'red'"
    },
    "success-ink": {
      "light": "#228833",
      "dark": "#44BB99",
      "use": "Text and icons for success on the bare page. Light: Tol dark 'green'"
    },
    "warning-ink": {
      "light": "#775500",
      "dark": "#EEDD88",
      "use": "Text and icons for warnings on the bare page. Light: Tol dark 'dark yellow'"
    },
    "info-ink": {
      "light": "#4477BB",
      "dark": "#99DDFF",
      "use": "Text and icons for information on the bare page. Light: Tol dark 'blue'"
    }
  },
  "font": {
    "family": {
      "ui": "\"Atkinson Hyperlegible Mono\", ui-monospace, \"Courier New\", monospace",
      "read": "\"Atkinson Hyperlegible Next\", system-ui, sans-serif",
      "receipt": "\"Courier Prime\", \"Courier New\", monospace",
      "malayalam": "\"Noto Serif Malayalam\", serif"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "bold": "700"
    },
    "root-size": "112.5%"
  },
  "type": {
    "hero": {
      "size": "1.5rem",
      "line": "1.4167",
      "px": "27 / 38"
    },
    "title": {
      "size": "1.75rem",
      "line": "1.25",
      "px": "32 / 40"
    },
    "section": {
      "size": "1.25rem",
      "line": "1.35",
      "px": "22 / 30"
    },
    "sub": {
      "size": "1rem",
      "line": "1.5556",
      "px": "18 / 28"
    },
    "body": {
      "size": "1rem",
      "line": "1.5556",
      "px": "18 / 28"
    },
    "secondary": {
      "size": "0.8889rem",
      "line": "1.5",
      "px": "16 / 24"
    },
    "small": {
      "size": "0.7778rem",
      "line": "1.4286",
      "px": "14 / 20"
    },
    "total": {
      "size": "1.75rem",
      "line": "1.125",
      "px": "32 / 36"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "layout": {
    "measure": "560px",
    "pad-phone": "16px",
    "pad-wide": "24px",
    "touch-min": "44px",
    "touch-preferred": "48px"
  },
  "border": {
    "rule": "2px solid var(--ink)",
    "hair": "1px solid var(--line)",
    "focus": "3px"
  },
  "radius": {
    "square": "0"
  },
  "motion": {
    "state": "120ms",
    "sheet": "200ms",
    "wordmark": "4.4s"
  },
  "texture": {
    "tape-hatch": "repeating-linear-gradient(115deg, rgb(255 255 255 / 25%) 0 1.5px, transparent 1.5px 4px)"
  },
  "display": {
    "$comment": "User display settings, applied as data attributes on <html>: data-text=\"large\", data-contrast=\"high\", data-colour=\"reduced\".",
    "text-large-root-size": "125%",
    "reduced-fill": "#E6E6E6"
  }
}
